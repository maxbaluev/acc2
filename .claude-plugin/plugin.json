{
  "name": "accint",
  "displayName": "AccInt",
  "description": "Claude Code integration for the AccInt substrate.",
  "version": "0.1.0",
  "mcpServers": {
    "accint": {
      "type": "stdio",
      "command": "bun",
      "args": ["run", "runtime/mcp_server/stdio.ts"],
      "env": {
        "ACC2_STATE_DIR": "${ACC2_STATE_DIR:-~/.acc2}"
      }
    }
  }
}
