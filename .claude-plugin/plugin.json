{
  "name": "accint",
  "displayName": "AccInt",
  "description": "Claude Code integration for the AccInt substrate.",
  "version": "0.1.0",
  "mcpServers": {
    "accint": {
      "type": "stdio",
      "command": "bun",
      "args": ["run", "runtime/mcp_server_stdio_entry.ts"],
      "env": {
        "ACC2_STATE_DIR": "${ACC2_STATE_DIR:-~/.accint}",
        "ACC2_CANONICAL_DB_PATH": "${ACC2_CANONICAL_DB_PATH:-./.claude-plugin/substrate/canonical.db}"
      }
    }
  }
}
