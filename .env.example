# ═══════════════════════════════════════════════════════════════════
# AccInt Configuration
#
# Canonical onboarding doc: docs/quickstart.md. The required-vs-optional
# story below is the same one quickstart.md and `acc doctor` use — only
# OPENAI_API_KEY is required for first run; everything else is optional
# and never blocks.
#
# You normally do not edit this file by hand: `bun run acc task "hello"`
# scaffolds .env from this template and prompts for OPENAI_API_KEY on
# first run.
# ═══════════════════════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────────────────
# Brain (GPT-5.5) runs via OpenCode — authenticate with: opencode auth login
# Embeddings use your OpenAI API key directly.

# OpenAI API key — REQUIRED for knowledge embeddings.
# Without this, the system cannot start. `acc task "hello"` prompts for it.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── OPTIONAL CAPABILITIES ───────────────────────────────────────────
# Everything below is optional and never blocks first run. AccInt works
# without any of these; each one extends what the system can do.

# ── Workspace ──────────────────────────────────────────────────────

# OPTIONAL — Override the workspace root directory.
# Default: auto-detected from the repository structure.
# Use when running AccInt from a non-standard directory or when
# multiple operators share the same codebase with isolated state.
# ACC_HOME=/path/to/system

# ── Browser ────────────────────────────────────────────────────────
# Default: Patchright (local, zero config). No setup needed.

# OPTIONAL — Browser provider: "patchright" (default) or "adspower".
# Patchright works out of the box — no external service required.
# AdsPower is for anti-detect browser profiles (requires subscription).
# BROWSER_PROVIDER=patchright

# OPTIONAL — Run browser headless (no visible window). Default: false.
# BROWSER_HEADLESS=false

# OPTIONAL — AdsPower config (only if BROWSER_PROVIDER=adspower).
# Most operators should skip this — Patchright is sufficient.
# ADSPOWER_URL=http://127.0.0.1:50325
# ADSPOWER_API_KEY=
# ADSPOWER_PROFILE_ID=

# ── Web Search ─────────────────────────────────────────────────────

# OPTIONAL — Serper API key for web/scholar/news search.
# Never blocks first run. The brain runs without it; research is just
# narrower (no live web/scholar lookups). Add it later when you want
# the brain to do real-time research.
# Free tier available — get a key at: https://serper.dev
# SERPER_API_KEY=

# ── Owner Communication ────────────────────────────────────────────

# OPTIONAL — Telegram bot for notifications, HIDL decisions, overnight digests.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Proxies ────────────────────────────────────────────────────────

# OPTIONAL — Named proxy references. Domain persona configs in domains.json
# reference these via the proxy_ref field.
# PROXY_DEFAULT=socks5://user:pass@proxy.example.com:1080
# PROXY_BR=http://user:pass@br-proxy.example.com:8080

# ── Operator Identity ──────────────────────────────────────────────

# OPTIONAL — Identifies who is running this AccInt instance.
# Used in runtime receipts and strategist run archives for audit trails.
# Recommended for shared codebases or multi-operator setups.
# ACC_OPERATOR=tony

# ── External Mode ─────────────────────────────────────────────────

# OPTIONAL — When set, the strategist minimizes architectural disclosure:
# suppresses internal codenames, uses public aliases, limits tool schema
# exposure. Use when AccInt operates in shared or public repositories.
# ACC_EXTERNAL_MODE=1

# ── Distribution ───────────────────────────────────────────────────

# OPTIONAL — Pinata JWT for IPFS publishing (encrypted workspace packages).
# Get one at: https://pinata.cloud → API Keys → New Key
# Required permissions: pinFileToIPFS, unpin
# PINATA_JWT=

# ── Advanced / Rarely Needed ───────────────────────────────────────

# OPTIONAL — Timeout overrides (milliseconds).
# ACC_HARD_SILENCE_TIMEOUT_MS=180000
# ACC_SOFT_NO_TOOLS_TIMEOUT_MS=420000
# ACC_FIRST_TOOL_DEADLINE_MS=300000
# ACC_REFLECT_TIMEOUT=3600

# OPTIONAL — Budget warning threshold: log a warning when tool calls exceed
# this count (default: 200). Advisory only — does NOT kill the session
# (killing risks data loss mid-save).
# ACC_BUDGET_WARN_THRESHOLD=200

# OPTIONAL — Consecutive failure circuit breaker: abort session after this many
# consecutive failed strategist cycles (default: 10). Prevents runaway loops
# when the strategist is stuck in a failure pattern.
# ACC_MAX_CONSECUTIVE_FAILURES=10
