# AccInt v2 — environment template
# Copy to .env and fill in.

# Required: text-embedding-3-small for substrate retrieval.
OPENAI_API_KEY=sk-...

# Runtime defaults are the universal workflow: real bridge, standard timeouts,
# all workers on, and substrate-owned scheduling. Tests pin mock behavior via
# bunfig.toml -> tests/preload.ts.

# Optional: state directory and daemon bind ports.
# ACC2_STATE_DIR=/home/me/.accint
# V2_DAEMON_PORT=9387
# V2_DAEMON_AUX_PORT=9388

# Optional: non-default opencode model only.
# ACC2_OPENCODE_MODEL=openai/gpt-5.5

# Optional: Camoufox binary path (v2 auto-detects ~/.cache/camoufox/camoufox).
# CAMOUFOX_BINARY_PATH=/home/me/.cache/camoufox/camoufox

# Optional: Background workers. ALL default to ON in production — the
# substrate is meant to run the full organism out of the box (embedder
# computing sqlite-vec embeddings, scheduler draining ready dispatches,
# father re-ranking objectives, rolling-reviewer firing cadence-driven
# re-opens, rehab probing quarantined artifacts, integrity scrubbing
# WAL hygiene). The canonical opt-OUT is ONE env var carrying a
# comma-separated list of worker names. Empty / unset = all six run.
# Tests pin the full set via tests/preload.ts so the unit suite stays
# hermetic. The legacy per-worker autostart vars (ACC2_EMBEDDER_AUTOSTART,
# ACC2_AUTOSCHEDULER, ACC2_FATHER_AUTOSTART, ACC2_ROLLING_AUTOSTART,
# ACC2_INTEGRITY_AUTOSTART, ACC2_REHAB_AUTOSTART) have been REMOVED —
# the runtime no longer reads them; migrate to ACC2_DISABLE_WORKERS.
# Worker names: embedder, scheduler, father, rolling_reviewer,
# rehabilitation, integrity.
# ACC2_DISABLE_WORKERS=embedder,father

# Optional: Father iteration cadence (default 5 min; crisis mode → 30 sec).
# ACC2_FATHER_INTERVAL_MS=300000

# Optional: Integrity worker cadence (default 6 hours).
# ACC2_INTEGRITY_INTERVAL_MS=21600000

# Optional: External-push admin token (for /external/push webhook auth).
# ACC2_EXTERNAL_PUSH_TOKEN=...

# Optional: MCP server URL the daemon exports for spawned opencode
# subprocesses. Defaults to http://${host}:${port}/mcp where host/port
# are resolved from V2_DAEMON_PORT and the daemon's bound interface.
# Override for reverse-proxy / containerised deploys where opencode
# must reach the daemon via a different URL than the daemon binds.
# V2_MCP_SERVER_URL=http://127.0.0.1:9387/mcp

# Optional: log level (silent | debug | info | warn | error).
# ACC2_LOG_LEVEL=info
# ACC2_LOG_FILE=0
